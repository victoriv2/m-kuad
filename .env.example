# Paystack Secret Key (Get from https://dashboard.paystack.com/#/settings/developers)
# NEVER commit your real secret key to GitHub — add it in Vercel Environment Variables
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# Your private Telegram group/channel invite link (kept secret on the server until payment succeeds)
TELEGRAM_GROUP_URL=https://t.me/+your_invite_link

# Your deployed website URL (e.g. https://m-kuad.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: JSONBin.io for logging verified Telegram usernames to local admin
JSONBIN_MASTER_KEY=
JSONBIN_BIN_ID=
